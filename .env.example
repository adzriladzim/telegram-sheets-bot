# Telegram
TELEGRAM_BOT_TOKEN=isi_token_dari_BotFather

# Google
# Isi dengan ID sheet nyata dari spreadsheet masing-masing (jangan pakai contoh).
GOOGLE_SHEET_ID=ganti_google_sheet_id
# Lokal: path file JSON. Railway: KOSONGKAN ini, isi GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT.
GOOGLE_SERVICE_ACCOUNT_JSON=secrets\service_account.json
# Railway: paste SELURUH isi service_account.json dalam 1 baris
# GOOGLE_SERVICE_ACCOUNT_JSON_CONTENT={"type":"service_account",...}

# Identity (opsional — multi-user: tiap user daftar via /register, tersimpan di data/users.json.
# Nilai di sini hanya fallback / seed untuk chat lama di data/chats.json)
# FACILITATOR_NAME=Adzril Adzim Hendrynov

# Sheet names (Batch 5 — Ganjil 26/27)
MASTER_SHEET_NAME=Jadwal Fasil Blok A Ganjil 26/27
ZOOM_RECORD_SHEET_NAME=Zoom Record Blok A Ganjil 26/27
BACKUP_SHEET_NAME=Backup Fasilitator Blok A Ganjil 26/27
CANCEL_SHEET_NAME=Kelas Cancel & Pengganti Blok A Ganjil 26/27
ABSEN_SHEET_ID=ganti_absen_sheet_id
ABSEN_SHEET_NAME=Computer Science
REKAP_SHEET_ID=ganti_rekap_sheet_id
REKAP_BUKTI_FOLDER_ID=
SEMESTER=1

# Daily reminder — jam UTC, dipisah koma (slot paling pagi WIB = jadwal penuh,
# slot lain = kelas yang belum di-log). 21,5,13 UTC = 04:00, 12:00, 20:00 WIB.
# Legacy REMINDER_HOUR/REMINDER_MINUTE masih didukung sebagai 1 slot.
REMINDER_TIMES="21,5,13"
REMINDER_ENABLED=true

# Heartbeat bot aktif (UTC; 22:00 UTC = 05:00 WIB)
HEARTBEAT_HOUR=22
HEARTBEAT_MINUTE=0
HEARTBEAT_ENABLED=true

# Darurat: semua kelas Reguler jadi Online
DARURAT_ONLINE=false

# BETA laporan PDF tersembunyi (/laporan). KOSONGKAN di luar beta.
# Chat id DAN nama (users.get) harus cocok — gagal = diam seperti command tak dikenal.
# LAPORAN_BETA_IDS=123456789,987654321
# LAPORAN_BETA_NAMES="Adzril Adzim Hendrynov|Fella Amalia S.T., M.T."
